{
  "name": "dsh-free-games",
  "version": "0.1.0",
  "description": "Free Spawnd.gg games cabinet for DeepSeek Harness Web, with search, hover previews, embedded play, and a minimized player.",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "data/spawnd_game_list.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "preview": "npm pack --dry-run --cache /tmp/npm-cache-dsh"
  },
  "keywords": [
    "deepseek-harness",
    "ds-free-games",
    "dsh",
    "dsh-plugin",
    "embed",
    "entertainment",
    "free-games",
    "games",
    "sidebar",
    "spawnd"
  ],
  "author": "Entaum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Entaum/dsh-free-games.git"
  },
  "bugs": {
    "url": "https://github.com/Entaum/dsh-free-games/issues"
  },
  "homepage": "https://github.com/Entaum/dsh-free-games#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "immediately": true
    },
    "market": {
      "displayName": "Free Games",
      "categories": [
        "entertainment",
        "ui"
      ]
    }
  }
}