{
  "name": "dsh-free-games",
  "version": "0.1.0",
  "description": "Free games cabinet for DeepSeek Harness. Games come from Spawnd.gg, a free premium games website.",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "data/spawnd_game_list.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "spawnd",
    "games",
    "free-games",
    "sidebar"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "market": {
      "displayName": "Free Games",
      "categories": ["entertainment", "ui"]
    }
  }
}
